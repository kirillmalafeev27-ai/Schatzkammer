{
  "name": "schatzkammer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Сокровищница (Die Schatzkammer) — учи немецкий, ищи сокровища",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:node",
    "build:node": "node scripts/build-node.mjs",
    "preview": "vite preview",
    "start": "node scripts/start-northflank.mjs",
    "start:node": "node dist/standalone/server.js",
    "start:northflank": "node scripts/start-northflank.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "tsx tools/sim.ts",
    "shots": "tsx tools/shots.ts"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
