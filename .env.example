# Только для сервера (npm run dev / preview / start). Скопируйте в .env.local и задайте ключ;
# в браузер он не попадает.
AITUNNEL_API_KEY=
AITUNNEL_MODEL=gpt-5.4
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Необязательно: аудирование озвучивается через ElevenLabs, если задан ключ, и голосом браузера,
# если нет.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_TIMEOUT_MS=30000
TTS_CACHE_LIMIT=180

# Необязательная настройка.
QUESTION_GENERATION_TIMEOUT_MS=45000
QUESTION_CACHE_LIMIT=96
# Сколько остатков пакетов держит одна комбинация уровень / грамматика / лексика.
QUESTION_POOL_LIMIT=60
QUESTION_GENERATION_CONCURRENCY=4
QUESTION_FAILURE_COOLDOWN_MS=15000
RECALL_EVALUATION_TIMEOUT_MS=8000
RECALL_EVALUATION_CONCURRENCY=6
