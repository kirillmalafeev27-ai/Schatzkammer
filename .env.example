# Только для сервера (npm run dev / preview / start). Скопируйте в .env.local и задайте ключ;
# в браузер он не попадает. Генерация — quiz-generation.cjs «Шахты» и See Escape, переменные те же.
AITUNNEL_API_KEY=
# Модели через запятую пробуются по очереди.
AI_MODELS=gpt-5.4
# Свой шлюз; без него — https://api.aitunnel.ru/v1 (с OPENAI_API_KEY — https://api.openai.com/v1).
# AI_BASE_URL=
AI_TIMEOUT_MS=45000

# Необязательно: аудирование озвучивается через ElevenLabs, если задан ключ, и голосом браузера,
# если нет.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_TIMEOUT_MS=30000
TTS_CACHE_LIMIT=180
# Папка дискового кэша озвучки; по умолчанию — во временной папке системы.
# TTS_CACHE_DIR=

# Проверка свободного ответа моделью (режим «Воспроизведение»).
RECALL_EVALUATION_TIMEOUT_MS=8000
RECALL_EVALUATION_CONCURRENCY=6
